(version 1)

# Piezo Insulin Pump v2 - project DRC rules (generic; replace/extend with the fab's rules, OPEN B.7)

# J703 is the PMD401 48 V power connector chosen by PiezoMotor (JST SH SM02B-SRSS-TB, 1.0 mm pitch,
# PMD401 manual 150025-01 sec.3.4). Its own pad pitch gives 0.4 mm between +48V and GND, below the
# 0.6 mm HV48 net-class clearance. Exception is scoped to pad-to-pad inside J703 ONLY. See
# docs/handover/UNRESOLVED_ISSUES.md U-17 (confirm JST SH ratings for this use).
(rule "J703_vendor_connector_pitch"
	(condition "A.memberOfFootprint('J703') && B.memberOfFootprint('J703')")
	(constraint clearance (min 0.35mm)))

# Q301 (TI CSD16340Q3, KiCad VSON-8 3.3x3.3 NexFET land pattern): source pad 3 to gate pad 4 is 0.14 mm
# by footprint geometry (0.65 mm pitch). Scoped to pads of Q301 only; 0.127 mm (5 mil) is a common 4-layer
# fab minimum - confirm with the chosen fab (OPEN B.7) and against the TI DQG0008 land pattern (U-12/U-17).
(rule "Q301_nexfet_pad_pitch"
	(condition "A.memberOfFootprint('Q301') && B.memberOfFootprint('Q301')")
	(constraint clearance (min 0.127mm)))

# FL501 MLPF-WB-04D3 bump pitch 0.5 mm with 0.32 mm pads gives 0.18 mm between bumps (DS14446 sec.3). Scoped to pads of FL501 only.
(rule "FL501_bump_pitch"
	(condition "A.memberOfFootprint('FL501') && B.memberOfFootprint('FL501')")
	(constraint clearance (min 0.15mm)))
